{
  "name": "plana",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun run --watch src/server/index.ts",
    "build": "run-s type-check build:client build:server",
    "build:client": "vite build --outDir dist/client --ssrManifest",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server",
    "start": "NODE_ENV=production bun run src/server/index.ts",
    "commands:deploy": "bun run src/server/discord/deploy-commands.ts",
    "backup": "bun run src/server/backup-now.ts",
    "type-check": "run-s type-check:app type-check:server",
    "format": "bun fmt src/",
    "format:check": "bun fmt --check src/",
    "type-check:app": "node scripts/vue-tsc.cjs -p tsconfig.app.json --noEmit",
    "type-check:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "hono": "^4.13.14",
    "i18next": "^26.5.10",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "npm:rolldown-vite@^7.3.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.13"
  }
}
