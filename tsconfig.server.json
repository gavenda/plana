{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["src/server/**/*", "env.d.ts"],
  "compilerOptions": {
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "types": ["bun"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
