[Unit]
Description=Plana cache (Redis)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=plana-redis
Image=docker.io/redis:8-alpine
Pod=plana.pod

# Cache only: no persistence, bounded memory, evict least-recently-used first.
# Nothing here needs to survive a restart, so there is no volume.
# Bound to loopback inside the pod's network namespace; no port is published for it.
#
# `--save` is deliberately last and has no argument. Quadlet's Exec parser drops an
# empty `""` token *and everything after it*, so the documented `--save ""` form would
# silently discard the memory limits. A bare trailing `--save` sets an empty save
# config, which is exactly what `--save ""` means: persistence off.
Exec=redis-server --bind 127.0.0.1 --appendonly no --maxmemory 64mb --maxmemory-policy allkeys-lru --save

HealthCmd=redis-cli ping
HealthInterval=10s
HealthTimeout=3s
HealthRetries=5
HealthStartPeriod=5s

ReadOnly=true
Tmpfs=/tmp
Tmpfs=/data
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
