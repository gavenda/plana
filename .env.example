# ---------------------------------------------------------------- Discord ---
# Bot page -> Token. Keep this secret; anyone holding it controls the bot.
DISCORD_TOKEN=

# OAuth2 page -> Client ID / Client Secret. The client ID is also the app ID.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Right-click your server -> Copy Server ID (requires Developer Mode).
DISCORD_GUILD_ID=

# ------------------------------------------------------------------- Web ----
# Public origin of the dashboard. Must exactly match the redirect URI registered
# under OAuth2 -> Redirects, which is this value plus /auth/callback.
PUBLIC_BASE_URL=http://localhost:3000

HOST=0.0.0.0
PORT=3000

# At least 32 characters; changing it signs every existing session out.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

SESSION_TTL_DAYS=7

# ---------------------------------------------------------------- Storage ---
# In the container image this defaults to /data/plana.db on a mounted volume.
DATABASE_PATH=./data/plana.db

# ------------------------------------------------------------------ Cache ---
# Redis caches the triage queue and the role/channel directory so the bot does not
# re-request the member list from the gateway on every dashboard load. It is a cache
# only: if Redis is down the bot keeps working and serves everything live.
# In the container stack this is redis://redis:6379.
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------- Backups ---
# Off-site copies of the database in a Cloudflare R2 bucket. Leave all four blank to
# run without backups. In the Cloudflare dashboard:
#   1. R2 -> Create bucket (e.g. plana-backups).
#   2. R2 -> Manage API tokens -> Create API token: "Object Read & Write", limited to
#      that bucket. Copy the Access Key ID and Secret Access Key it shows once.
#   3. The bucket -> Settings -> Object lifecycle rules: delete objects with prefix
#      plana/ after e.g. 3 days. Without this, backups are kept forever.
# Account ID is on the R2 overview page. Test with `bun run backup`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Only if the bucket was created in a jurisdiction (Create bucket -> Location ->
# Specify jurisdiction): eu or fedramp. Leave blank otherwise.
R2_JURISDICTION=
# A backup is taken this often, counted from the newest one already in the bucket.
BACKUP_INTERVAL_HOURS=24
# Off by default, leaving old backups to the lifecycle rule in step 3. Set a number
# of days to have the bot delete older backups itself instead (the newest is always
# kept); then step 3 is not needed.
BACKUP_RETENTION_DAYS=off

# -------------------------------------------------------------- Birthdays ---
# IANA time zone the server's day runs on. Birthday messages post just after its
# midnight. Examples: Europe/Dublin, America/New_York, Asia/Manila.
BIRTHDAY_TIMEZONE=UTC

# -------------------------------------------------- Optional first-boot seed -
# These pre-fill the dashboard settings on first start. Leave blank and set them
# in the dashboard instead. Values already saved are never overwritten.
TRIAGE_ROLE_ID=
UNIT_OWNER_ROLE_ID=
BOARDERS_ROLE_ID=
ANNOUNCE_CHANNEL_ID=
# Leave unset to keep birthday announcements off.
BIRTHDAY_CHANNEL_ID=
# A dedicated role members hold only on their birthday. Leave unset to keep it off.
BIRTHDAY_ROLE_ID=
# Members with this role can sign in to the dashboard and handle triage, but cannot
# change settings or broadcast. Administrators always have full access.
MODERATOR_ROLE_ID=
