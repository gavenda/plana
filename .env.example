# ---------------------------------------------------------------- Discord ---
# Bot page -> Token. Keep this secret; anyone holding it controls the bot.
DISCORD_TOKEN=

# OAuth2 page -> Client ID / Client Secret. The client ID is also the app ID.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Right-click your server -> Copy Server ID (requires Developer Mode).
DISCORD_GUILD_ID=

# ------------------------------------------------------------------- Web ----
# Public origin of the dashboard. Must exactly match the redirect URI registered
# under OAuth2 -> Redirects, which is this value plus /auth/callback.
PUBLIC_BASE_URL=http://localhost:3000

HOST=0.0.0.0
PORT=3000

# At least 32 characters; changing it signs every existing session out.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

SESSION_TTL_DAYS=7

# ---------------------------------------------------------------- Storage ---
# In the container image this defaults to /data/plana.db on a mounted volume.
DATABASE_PATH=./data/plana.db

# ------------------------------------------------------------------ Cache ---
# Redis caches the triage queue and the role/channel directory so the bot does not
# re-request the member list from the gateway on every dashboard load. It is a cache
# only: if Redis is down the bot keeps working and serves everything live.
# In the container stack this is redis://redis:6379.
REDIS_URL=redis://127.0.0.1:6379

# -------------------------------------------------- Optional first-boot seed -
# These pre-fill the dashboard settings on first start. Leave blank and set them
# in the dashboard instead. Values already saved are never overwritten.
TRIAGE_ROLE_ID=
UNIT_OWNER_ROLE_ID=
BOARDERS_ROLE_ID=
ANNOUNCE_CHANNEL_ID=
